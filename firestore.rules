rules_version = '2';
// BoT Arena — private: only accounts approved by the owner can read or write.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function ownerPath() { return /databases/$(database)/documents/meta/owner; }
    function hasMe() { return signedIn() && exists(userPath(request.auth.uid)); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function approved() { return hasMe() && me().status == 'approved'; }
    function isOwner() { return hasMe() && me().role == 'owner' && me().status == 'approved'; }

    // first account ever becomes the owner (created in one batch with its user doc)
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerPath()) && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'owner';
      allow update, delete: if false;
    }
    match /meta/config {
      allow read: if approved();
      allow write: if isOwner();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'member' && request.resource.data.status == 'pending')
        || (request.resource.data.role == 'owner' && request.resource.data.status == 'approved'
            && !exists(ownerPath()) && getAfter(ownerPath()).data.uid == uid));
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'name', 'photo']))
                    || (isOwner() && uid != request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status in ['approved', 'pending', 'blocked']);
      allow delete: if isOwner() && uid != request.auth.uid;
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid && approved();
      }
    }
    match /decks/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.owner == request.auth.uid;
      allow update: if approved() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if approved() && resource.data.owner == request.auth.uid;
    }
    match /matches/{id} {
      allow read, delete: if approved() && resource.data.uid == request.auth.uid;
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
    }
    match /games/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.host == request.auth.uid && request.resource.data.status == 'waiting';
      allow update: if approved() && (request.auth.uid in resource.data.seats
        || (resource.data.status == 'waiting' && request.resource.data.guest == request.auth.uid
            && request.resource.data.seats == [resource.data.host, request.auth.uid]));
      allow delete: if approved() && request.auth.uid in resource.data.seats;
    }
  }
}
